<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/white"
        app:title="ElephAlert" />

    <!-- Safety Status Bar -->
    <LinearLayout
        android:id="@+id/safetyStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/safe">

        <!-- Top Row: Status Icon and Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSafetyIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="🟢"
                android:textSize="24sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvSafetyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOU ARE SAFE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvSafetyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No danger zones nearby"
                    android:textSize="12sp"
                    android:textColor="#CCFFFFFF" />
            </LinearLayout>

            <!-- Speed Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#33FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="8dp"
                app:cornerRadius="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textSize="11sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar for Danger Proximity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvProximityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearest Danger Zone: Scanning..."
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressDanger"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/warning"
                android:progressBackgroundTint="#33FFFFFF" />

            <TextView
                android:id="@+id/tvWarningHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Danger zone within 2km - Stay alert!"
                android:textSize="10sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Driver!"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:paddingBottom="0dp" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnReportSighting"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📝 Report Sighting"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/warning"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSafetyInfo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="⚠️ Safety Tips"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Map -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Zoom Controls - Correctly placed here -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_zoom_in"
                android:backgroundTint="@color/white"
                app:fabSize="mini"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_zoom_out"
                android:backgroundTint="@color/white"
                app:fabSize="mini"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMyLocation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_my_location"
                android:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:fabSize="mini" />

        </LinearLayout>

        <!-- Nearest Alert Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNearestAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/danger_light"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⚠️"
                    android:textSize="24sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elephant Crossing Ahead"
                        android:textColor="@color/danger"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to view details"
                        android:textColor="@color/gray_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnViewAlert"
                    style="@style/OutlinedPillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="View"
                    android:minWidth="60dp"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary" />

</LinearLayout>