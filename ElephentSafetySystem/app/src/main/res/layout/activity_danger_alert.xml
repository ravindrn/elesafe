<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- Blinking red background -->
    <View
        android:id="@+id/blinkView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:layout_centerInParent="true">

            <!-- Warning Icon -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_danger_alert"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp" />

            <!-- Alert Title -->
            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ DANGER ZONE! ⚠️"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Zone Name -->
            <TextView
                android:id="@+id/tvZoneName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entering Danger Zone"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:layout_marginBottom="16dp" />

            <!-- Risk Level -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Risk Level: "
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvRiskLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFEB3B" />
            </LinearLayout>

            <!-- Distance -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance: "
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 meters"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFEB3B" />
            </LinearLayout>

            <!-- Instructions Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="8dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 IMMEDIATE ACTIONS 🚨"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FF0000"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• REDUCE SPEED IMMEDIATELY\n• STAY EXTREMELY ALERT\n• WATCH FOR ELEPHANTS CROSSING\n• DO NOT USE HORN\n• DO NOT FLASH HEADLIGHTS\n• MAINTAIN SAFE DISTANCE\n• BE PREPARED TO STOP"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:lineSpacingExtra="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Acknowledge Button -->
            <Button
                android:id="@+id/btnAcknowledge"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="I UNDERSTAND - SLOW DOWN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#FF4B4B"
                app:cornerRadius="30dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>